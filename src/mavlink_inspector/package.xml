<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mavlink_inspector</name>
  <version>1.0.0</version>
  <description>Main MAVLink/Pixhawk connection hub for BRACU Duburi 4.2. Monitors connection, relays events, provides telemetry.</description>
  <maintainer email="duburi@bracu.edu.bd">BRACU Duburi</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>duburi_interfaces</depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>python3-pymavlink</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
