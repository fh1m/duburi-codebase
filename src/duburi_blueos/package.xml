<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duburi_blueos</name>
  <version>1.0.0</version>
  <description>BlueOS integration for BRACU Duburi AUV 4.2. Provides REST API client, system monitoring, and MAVLink endpoint management for BlueOS running on Raspberry Pi 4B.</description>
  <maintainer email="duburi@bracu.edu.bd">BRACU Duburi</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>duburi_interfaces</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-aiohttp</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
